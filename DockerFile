# 1️⃣ استخدام صورة Python خفيفة
FROM python:3.11-slim

# 2️⃣ تعيين مجلد العمل
WORKDIR /app

# 3️⃣ نسخ ملف requirements
COPY requirements.txt .

# 4️⃣ تحديث pip وتثبيت torch CPU فقط
RUN pip install --upgrade pip \
    && pip install torch==2.2.2+cpu -f https://download.pytorch.org/whl/torch_stable.html

# 5️⃣ تثبيت باقي المكتبات
RUN pip install --no-cache-dir -r requirements.txt

# 6️⃣ نسخ باقي ملفات التطبيق
COPY . .

# 7️⃣ فتح البورت
EXPOSE 7860

# 8️⃣ تشغيل Uvicorn من مجلد Back-end
CMD ["uvicorn", "Back-end.main:app", "--host", "0.0.0.0", "--port", "7860", "--reload"]
